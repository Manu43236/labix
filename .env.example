# MySQL (matches docker-compose.yml defaults)
DB_URL=jdbc:mysql://localhost:3306/labix?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=labix
DB_PASSWORD=labix

# JWT — must be at least 32 chars, generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-32-char-secret
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# File storage
UPLOAD_DIR=./uploads

# CORS — comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Spring profile (use 'prod' in production)
SPRING_PROFILES_ACTIVE=default
