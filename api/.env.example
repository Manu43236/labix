# Copy to .env and fill in values before running
DB_URL=jdbc:mysql://localhost:3306/labix?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=labix
DB_PASSWORD=labix
JWT_SECRET=change-this-to-a-random-32-char-secret-here
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000
PORT=8080
UPLOAD_DIR=./uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set to 'prod' in production
SPRING_PROFILES_ACTIVE=default
